{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "@cloudflare/workers-types"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": [
    "node_modules",
    "examples",
    ".ayjnt",
    "**/.ayjnt/**",
    // Browser-only files. Live in tsconfig.client.json which adds DOM
    // lib + @types/react. Excluding them here keeps the worker-side
    // check honest about not using DOM globals.
    "src/runtime/voiceClient.tsx",
    "src/runtime/voiceClient.test.ts"
  ]
}
