---
import {
	ArrowRight,
	Cloud,
	GitBranch,
	Package,
	Terminal as TerminalIcon,
} from "lucide-react";
import DocsLayout from "@/layouts/DocsLayout.astro";
import Button from "@/components/Button.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { DOCS_SECTIONS } from "@/content/docs-nav";

const cloudflareRefs = [
	{ title: "Agents API reference", href: "https://developers.cloudflare.com/agents/api-reference/agents-api/" },
	{ title: "Configuration (wrangler.jsonc)", href: "https://developers.cloudflare.com/agents/api-reference/configuration/" },
	{ title: "Client SDK (useAgent, agentFetch)", href: "https://developers.cloudflare.com/agents/api-reference/client-sdk/" },
	{ title: "Calling agents from another worker", href: "https://developers.cloudflare.com/agents/api-reference/calling-agents/" },
	{ title: "Scheduling + alarms", href: "https://developers.cloudflare.com/agents/api-reference/schedule-tasks/" },
	{ title: "Model Context Protocol (MCP)", href: "https://developers.cloudflare.com/agents/model-context-protocol/" },
];

const quickStartSteps = [
	{ n: 1, title: "Install Bun", sub: "ayjnt is Bun-first", command: "curl -fsSL https://bun.com/install | bash" },
	{ n: 2, title: "Scaffold a project", sub: "Minimal or with React UI", command: "bunx ayjnt new my-app --with-ui" },
	{ n: 3, title: "Install + dev", sub: "wrangler dev with live reload", command: "cd my-app && bun install && bun run dev" },
	{ n: 4, title: "Deploy", sub: "Git preflight, then wrangler deploy", command: "bun run deploy" },
];

const counterAgentCode = `import { Agent } from "agents";
import type { GeneratedEnv } from "@ayjnt/env";

type State = { count: number };

export default class CounterAgent extends Agent<GeneratedEnv, State> {
  override initialState: State = { count: 0 };

  override async onRequest(): Promise<Response> {
    return Response.json({ instance: this.name, ...this.state });
  }
}`;
---
<DocsLayout
	title="Docs — ayjnt"
	description="Comprehensive documentation for ayjnt — concepts, guides, reference, and troubleshooting, from beginner to expert."
>
	<div>
		<header class="mb-10 border-b border-[var(--rule-strong)] pb-6">
			<span class="tag mb-3 inline-block">documentation</span>
			<h1 class="font-sans text-[38px] font-semibold leading-tight tracking-tight">
				Everything you need to ship an agent.
			</h1>
			<p class="mt-3 max-w-3xl text-[18px] leading-relaxed text-[var(--ink-soft)]">
				ayjnt is a thin framework over the Cloudflare Agents SDK. These
				docs walk you from your first scaffold to the last detail of
				the build pipeline. Read top-to-bottom to ramp up, or jump
				straight to the reference for daily lookups.
			</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<Button href="/docs/getting-started/introduction" variant="primary">
					<ArrowRight className="h-4 w-4" />
					Start reading
				</Button>
				<Button href="https://github.com/northclock/ayjnt" variant="secondary" external>
					<GitBranch className="h-4 w-4" />
					Source on GitHub
				</Button>
				<Button href="https://www.npmjs.com/package/ayjnt" variant="ghost" external>
					<Package className="h-4 w-4" />
					ayjnt on npm
				</Button>
			</div>
		</header>

		<!-- Quick start block -->
		<section class="mt-4 border border-[var(--ink)] bg-[var(--paper-edge)]">
			<header class="flex items-center gap-3 border-b border-[var(--ink)] bg-[var(--paper)] px-5 py-3">
				<span
					class="inline-flex h-7 w-7 items-center justify-center border border-[var(--ink)] bg-[var(--amber-glow)]"
					aria-hidden="true"
				>
					<TerminalIcon className="h-4 w-4" />
				</span>
				<div>
					<div class="font-mono text-[10px] uppercase tracking-widest text-[var(--amber)]">
						Quick start
					</div>
					<h2 class="font-sans text-[18px] font-semibold leading-tight">
						From zero to running agent in four steps
					</h2>
				</div>
				<a
					href="/docs/getting-started/introduction"
					class="ml-auto hidden font-mono text-[11px] uppercase tracking-widest text-[var(--ink-muted)] hover:text-[var(--ink)] md:inline-flex"
				>
					Full walkthrough →
				</a>
			</header>

			<div class="grid gap-6 p-5 md:grid-cols-[1fr_1.1fr] md:gap-8 md:p-8">
				<ol class="flex flex-col gap-5">
					{quickStartSteps.map((step) => (
						<li class="flex items-start gap-3">
							<span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center border border-[var(--ink)] bg-[var(--paper)] font-mono text-[11px] font-semibold">
								{String(step.n).padStart(2, "0")}
							</span>
							<div class="min-w-0 flex-1">
								<div class="flex items-baseline justify-between gap-3">
									<h3 class="font-sans text-[15px] font-semibold text-[var(--ink)]">
										{step.title}
									</h3>
									<span class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink-muted)]">
										{step.sub}
									</span>
								</div>
								<pre class="mt-2 overflow-x-auto border border-[var(--rule-strong)] bg-[var(--paper)] px-3 py-2 font-mono text-[12.5px] leading-snug">
									<span class="mr-2 text-[var(--amber)]">$</span><span>{step.command}</span>
								</pre>
							</div>
						</li>
					))}
				</ol>

				<CodeBlock
					filename="my-app/agents/counter/agent.ts"
					lang="ts"
					code={counterAgentCode}
					highlightLines={[1, 2, 6, 7]}
				/>
			</div>
		</section>

		<!-- Section cards -->
		<div class="mt-16 flex flex-col gap-12">
			{DOCS_SECTIONS.map((section, i) => (
				<section>
					<header class="mb-5 flex items-center gap-3">
						<span class="inline-flex h-7 w-7 items-center justify-center border border-[var(--ink)] bg-[var(--paper)] font-mono text-[11px] font-semibold">
							{String(i + 1).padStart(2, "0")}
						</span>
						<h2 class="font-sans text-[22px] font-semibold tracking-tight">
							{section.title}
						</h2>
					</header>
					<ol class="grid gap-3 md:grid-cols-2">
						{section.items.map((item) => (
							<li>
								<a
									href={`/docs/${item.slug}`}
									class="card card-interactive group flex h-full flex-col gap-1.5 p-4"
								>
									<span class="flex items-center justify-between">
										<span class="font-mono text-[13px] font-semibold">
											{item.title}
										</span>
										<ArrowRight className="h-3.5 w-3.5 text-[var(--ink-muted)] transition-colors group-hover:text-[var(--amber)]" />
									</span>
									{item.blurb && (
										<span class="text-[14px] leading-snug text-[var(--ink-soft)]">
											{item.blurb}
										</span>
									)}
								</a>
							</li>
						))}
					</ol>
				</section>
			))}
		</div>

		<!-- Cloudflare reference -->
		<section class="mt-16 border-t border-[var(--rule-strong)] pt-8">
			<header class="mb-5 flex items-center gap-3">
				<Cloud className="h-5 w-5 text-[var(--ink-muted)]" />
				<h2 class="font-sans text-[22px] font-semibold tracking-tight">
					Cloudflare Agents reference
				</h2>
			</header>
			<p class="mb-4 max-w-3xl text-[15.5px] leading-relaxed text-[var(--ink-soft)]">
				ayjnt is built on top of Cloudflare's Agents SDK. For API
				reference, transport details, and Cloudflare-specific features
				(Workers AI, D1, R2, KV bindings, etc.) consult the official docs.
				ayjnt is not affiliated with Cloudflare.
			</p>
			<ul class="grid gap-3 md:grid-cols-2">
				{cloudflareRefs.map((item) => (
					<li>
						<a
							href={item.href}
							target="_blank"
							rel="noreferrer"
							class="card card-interactive flex items-center justify-between p-4"
						>
							<div>
								<div class="font-mono text-[13px] font-semibold">
									{item.title}
								</div>
								<div class="mt-0.5 truncate font-mono text-[11px] text-[var(--ink-muted)]">
									{item.href.replace(/^https:\/\//, "")}
								</div>
							</div>
							<ArrowRight className="h-4 w-4 shrink-0 text-[var(--ink-muted)]" />
						</a>
					</li>
				))}
			</ul>
		</section>
	</div>
</DocsLayout>
