---
import { ArrowLeft, GitBranch } from "lucide-react";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/Button.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import Screenshot from "@/components/Screenshot.astro";
import { Terminal } from "@/components/react/Terminal.tsx";
import { FileTree } from "@/components/react/FileTree.tsx";
import { EXAMPLES, type ExampleMeta } from "@/content/examples";

export function getStaticPaths() {
	return EXAMPLES.filter((e) => e.status === "stable").map((e) => ({
		params: { slug: e.slug },
		props: { example: e },
	}));
}

type Props = { example: ExampleMeta };
const { example } = Astro.props;
---
<BaseLayout
	title={`${example.title} — ayjnt example`}
	description={example.description}
>
	<div>
		<section class="relative isolate border-b border-[var(--ink)]">
			<div class="grid-paper absolute inset-0 opacity-50"></div>
			<div class="relative mx-auto max-w-5xl px-6 pt-14 pb-14">
				<a
					href="/examples"
					class="mb-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[var(--ink-muted)] hover:text-[var(--ink)]"
				>
					<ArrowLeft className="h-3 w-3" />
					All examples
				</a>
				<div class="flex flex-wrap items-center gap-2">
					{example.tags.map((t) => (
						<span class="tag">{t}</span>
					))}
				</div>
				<h1 class="mt-3 font-sans text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
					{example.title}
				</h1>
				<p class="mt-4 max-w-3xl text-lg leading-relaxed text-[var(--ink-soft)]">
					{example.description}
				</p>
				{example.exampleDir && (
					<div class="mt-6 flex flex-wrap gap-3">
						<Button
							href={`https://github.com/northclock/ayjnt/tree/main/${example.exampleDir}`}
							variant="secondary"
							external
						>
							<GitBranch className="h-4 w-4" />
							source on GitHub
						</Button>
					</div>
				)}

				{example.whatYoullLearn && example.whatYoullLearn.length > 0 && (
					<div class="mt-10 border-l-2 border-[var(--amber)] pl-4">
						<div class="font-mono text-xs uppercase tracking-widest text-[var(--amber)]">
							What you'll learn
						</div>
						<ul class="mt-3 space-y-1.5 text-sm text-[var(--ink-soft)]">
							{example.whatYoullLearn.map((item) => (
								<li class="flex items-start gap-2">
									<span
										class="mt-2 inline-block h-1 w-1 shrink-0 bg-[var(--amber)]"
										aria-hidden="true"
									></span>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</div>
		</section>

		{example.steps && example.steps.length > 0 && (
			<section class="bg-[var(--paper)]">
				<div class="mx-auto max-w-5xl px-6 py-16">
					<div class="flex flex-col gap-20">
						{example.steps.map((step, i) => (
							<article class="grid grid-cols-1 gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]">
								<header class="md:sticky md:top-24 md:self-start">
									<div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[var(--amber)]">
										<span class="inline-flex h-6 w-6 items-center justify-center border border-[var(--amber)] text-[10px] text-[var(--amber)]">
											{String(i + 1).padStart(2, "0")}
										</span>
										step
									</div>
									<h2 class="mt-3 font-sans text-2xl font-semibold tracking-tight md:text-3xl">
										{step.title}
									</h2>
									<p class="mt-3 text-[var(--ink-soft)] leading-relaxed">
										{step.blurb}
									</p>
								</header>
								<div class="flex flex-col gap-5">
									{step.terminal && (
										<Terminal client:visible lines={step.terminal} />
									)}
									{step.tree && (
										<FileTree client:visible root={step.tree} title={step.treeTitle} />
									)}
									{step.files?.map((f) => (
										<CodeBlock
											code={f.code}
											lang={f.lang}
											filename={f.path}
											highlightLines={f.highlightLines}
										/>
									))}
									{step.screenshot && (
										<Screenshot
											content={step.screenshot.content}
											label={step.screenshot.label}
										/>
									)}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		)}
	</div>
</BaseLayout>
