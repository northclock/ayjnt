---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Code from "../../components/Code.astro";
import { examples } from "../../content/examples";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

export function getStaticPaths() {
  return examples.map((example) => ({
    params: { slug: example.slug },
    props: { example },
  }));
}

const { example } = Astro.props;
const tutorialSteps = example.steps.map((step) => ({
  ...step,
  code: step.file
    ? readFileSync(
        fileURLToPath(
          new URL(
            `../../../../examples/${example.slug}/${step.file}`,
            import.meta.url,
          ),
        ),
        "utf8",
      )
    : undefined,
}));
const scaffold = `bunx ayjnt new ${example.projectName} --empty
cd ${example.projectName}
bun install${example.install ? `\n${example.install}` : ""}

# delete agents/alive after adding the files below`;
---

<BaseLayout title={`${example.title} example — Ayjnt`} description={example.description}>
  <article class="example-detail">
    <header class="example-detail-head">
      <div>
        <span class="eyebrow">Example {example.index}</span>
        <h1>{example.title}</h1>
        <p class="lede">{example.description}</p>
        <div class="detail-meta">
          <div><span>Pattern</span><strong>{example.teaches}</strong></div>
          <div><span>Result</span><strong><code>{example.open}</code></strong></div>
        </div>
        <a class="button primary" href={`https://github.com/northclock/ayjnt/tree/main/examples/${example.slug}`}>View source <span>↗</span></a>
      </div>
      <div class={`example-art art-${example.slug}`}>
        <span></span><span></span><span></span><span></span>
      </div>
    </header>

    <div class="example-tutorial">
      <section class="tutorial-intro">
        <span class="eyebrow">Guided build</span>
        <h2>Build it from an empty Ayjnt project</h2>
        <p>
          Follow the steps in order. Every source block below is the actual
          checked example file, so the tutorial and runnable project cannot
          quietly drift apart.
        </p>
      </section>

      <section class="tutorial-step">
        <div class="step-number">01</div>
        <div class="step-content">
          <h2>Scaffold and install</h2>
          <p>Create an empty harness and add only the dependencies this example needs.</p>
          <Code title="terminal" language="bash" code={scaffold} />
        </div>
      </section>

      {tutorialSteps.map((step, index) => (
        <section class="tutorial-step">
          <div class="step-number">{String(index + 2).padStart(2, "0")}</div>
          <div class="step-content">
            <h2>{step.title}</h2>
            <p set:html={step.body} />
            {step.file && step.code && (
              <>
                <p class="file-instruction">
                  Create <code>{step.file}</code> with this source:
                </p>
                <Code title={step.file} code={step.code} />
              </>
            )}
          </div>
        </section>
      ))}

      {example.environment && (
        <section class="tutorial-step">
          <div class="step-number">{String(tutorialSteps.length + 2).padStart(2, "0")}</div>
          <div class="step-content">
            <h2>Add the local secret</h2>
            <p>
              Put provider credentials in <code>.dev.vars</code>. This file
              stays local and should not be committed.
            </p>
            <Code title=".dev.vars" language="bash" code={example.environment} />
          </div>
        </section>
      )}

      <section class="tutorial-step">
        <div class="step-number">{String(tutorialSteps.length + (example.environment ? 3 : 2)).padStart(2, "0")}</div>
        <div class="step-content">
          <h2>Run the harness</h2>
          <Code
            title="terminal"
            language="bash"
            code={`bun run build\n${example.run}\n\n# open ${example.open}`}
          />
          <p>
            The build step generates bindings, migrations, client hooks, and
            environment types before the runtime starts.
          </p>
        </div>
      </section>

      <figure class="example-result">
        <img
          src={example.screenshot}
          alt={`${example.title} running in the browser`}
          loading="lazy"
        />
        <figcaption>Expected browser result after completing the tutorial.</figcaption>
      </figure>

      <h2>Project shape</h2>
      <div class="file-list">
        {example.files.map((file) => <span>{file}</span>)}
      </div>

      <h2>Verify your result</h2>
      <ol class="verify-list">
        {example.verify.map((item) => <li>{item}</li>)}
      </ol>

      <p><a href="/examples/">← Back to all examples</a></p>
    </div>
  </article>
</BaseLayout>
