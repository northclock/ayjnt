---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { examples } from "../../content/examples";
---

<BaseLayout
  title="Examples — Ayjnt"
  description="Six complete Ayjnt harnesses for coding, voice, chess, schedules, workflows, and multi-agent orchestration."
>
  <section class="examples-hero">
    <span class="eyebrow">Examples</span>
    <h1>Useful harnesses,<br />not feature fragments.</h1>
    <p>
      Six complete, opinionated examples. Each one solves a recognizable
      problem, gives humans a real interface, and isolates one architectural
      pattern worth reusing.
    </p>
  </section>
  <section class="examples-page-grid">
    <div class="example-grid">
      {examples.map((example) => (
        <a class={`example-card accent-${example.accent}`} href={`/examples/${example.slug}/`}>
          <div class="example-top"><span>{example.index}</span><i>↗</i></div>
          <div class={`example-art art-${example.slug}`}>
            <span></span><span></span><span></span><span></span>
          </div>
          <h3>{example.title}</h3>
          <p>{example.description}</p>
          <div class="tag-row">{example.tags.map((tag) => <span>{tag}</span>)}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
