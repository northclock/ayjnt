---
// The ayjnt brand mark: the northclock mascot + the "/AYjnt/" wordmark.
type Props = {
	class?: string;
	showWordmark?: boolean;
};
const { class: className = "", showWordmark = true } = Astro.props;
---
<span class={`inline-flex items-center gap-2 font-mono font-semibold ${className}`}>
	<img
		src="/mascot.svg"
		alt={showWordmark ? "" : "ayjnt"}
		aria-hidden={showWordmark ? "true" : undefined}
		width="28"
		height="28"
		class="h-7 w-7"
	/>
	{showWordmark && <span class="text-base tracking-tight">/AYjnt/</span>}
</span>
