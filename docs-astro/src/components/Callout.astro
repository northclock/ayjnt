---
import { AlertTriangle, Info, Lightbulb, OctagonAlert } from "lucide-react";

type Kind = "note" | "tip" | "warn" | "danger";

const STYLES: Record<Kind, { border: string; label: string }> = {
	note: { border: "border-[var(--blue)]", label: "Note" },
	tip: { border: "border-[var(--amber)]", label: "Tip" },
	warn: { border: "border-[#c07a00]", label: "Heads up" },
	danger: { border: "border-[#c0392b]", label: "Careful" },
};

const ICON: Record<Kind, typeof Info> = {
	note: Info,
	tip: Lightbulb,
	warn: AlertTriangle,
	danger: OctagonAlert,
};

type Props = {
	kind?: Kind;
	title?: string;
};

const { kind = "note", title } = Astro.props;
const style = STYLES[kind];
const Icon = ICON[kind];
---
<div class={`my-6 border-l-4 bg-[var(--paper-edge)] px-4 py-3 ${style.border}`}>
	<div class="mb-1 flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-widest">
		<Icon className="h-3.5 w-3.5" />
		{title ?? style.label}
	</div>
	<div class="prose-body text-[14.5px] leading-relaxed text-[var(--ink-soft)]">
		<slot />
	</div>
</div>
