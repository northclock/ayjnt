---
import { ArrowLeft, ArrowRight } from "lucide-react";
import Prose from "./Prose.astro";
import { getAdjacent, getSectionFor, getDocItem } from "@/content/docs-nav";

type Props = {
	/** Slug of the current page, e.g. "guides/middleware". */
	slug: string;
	/** Short subtitle under the title. One sentence positioning the page. */
	lede?: string;
};

const { slug, lede } = Astro.props;

const item = getDocItem(slug);
const section = getSectionFor(slug);
const { prev, next } = getAdjacent(slug);
---
{!item ? (
	<article>
		<p>Unknown docs slug: {slug}</p>
	</article>
) : (
	<article class="mx-auto w-full max-w-[720px]">
		<nav
			aria-label="Breadcrumb"
			class="mb-4 flex items-center gap-2 font-mono text-[11px] uppercase tracking-widest text-[var(--ink-muted)]"
		>
			<a href="/docs" class="hover:text-[var(--ink)]">Docs</a>
			{section && (
				<>
					<span aria-hidden="true">/</span>
					<span>{section.title}</span>
				</>
			)}
		</nav>
		<header class="mb-10 border-b border-[var(--rule-strong)] pb-6">
			<h1 class="font-sans text-[36px] font-semibold leading-tight tracking-tight text-[var(--ink)]">
				{item.title}
			</h1>
			{lede && (
				<p class="mt-3 text-[18px] leading-relaxed text-[var(--ink-soft)]">
					{lede}
				</p>
			)}
		</header>
		<Prose>
			<slot />
		</Prose>

		<nav
			aria-label="Pagination"
			class="mt-16 grid gap-3 border-t border-[var(--rule-strong)] pt-6 sm:grid-cols-2"
		>
			{prev ? (
				<a
					href={`/docs/${prev.slug}`}
					class="card card-interactive group flex flex-col gap-1 p-4"
				>
					<span class="flex items-center gap-1 font-mono text-[10px] uppercase tracking-widest text-[var(--ink-muted)]">
						<ArrowLeft className="h-3 w-3" />
						Previous
					</span>
					<span class="font-mono text-sm text-[var(--ink)] transition-colors group-hover:text-[var(--amber)]">
						{prev.title}
					</span>
				</a>
			) : (
				<span></span>
			)}
			{next ? (
				<a
					href={`/docs/${next.slug}`}
					class="card card-interactive group flex flex-col gap-1 p-4 text-right sm:col-start-2"
				>
					<span class="flex items-center justify-end gap-1 font-mono text-[10px] uppercase tracking-widest text-[var(--ink-muted)]">
						Next
						<ArrowRight className="h-3 w-3" />
					</span>
					<span class="font-mono text-sm text-[var(--ink)] transition-colors group-hover:text-[var(--amber)]">
						{next.title}
					</span>
				</a>
			) : (
				<span></span>
			)}
		</nav>
	</article>
)}
