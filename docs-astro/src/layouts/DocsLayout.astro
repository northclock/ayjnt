---
import BaseLayout from "./BaseLayout.astro";
import { docsNavigation } from "../content/navigation";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = "Documentation" } = Astro.props;
const path = Astro.url.pathname;
---

<BaseLayout title={`${title} — Ayjnt docs`} description={description}>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <div class="docs-sidebar-inner">
        {docsNavigation.map((group) => (
          <section>
            <h2>{group.label}</h2>
            {group.items.map((item) => (
              <a class:list={{ active: path === item.href }} href={item.href}>{item.label}</a>
            ))}
          </section>
        ))}
      </div>
    </aside>
    <article class="docs-article">
      <details class="docs-mobile-nav">
        <summary>Documentation menu</summary>
        <div>
          {docsNavigation.map((group) => (
            <section>
              <h2>{group.label}</h2>
              {group.items.map((item) => (
                <a class:list={{ active: path === item.href }} href={item.href}>{item.label}</a>
              ))}
            </section>
          ))}
        </div>
      </details>
      <header class="docs-heading">
        <span class="eyebrow">{eyebrow}</span>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <div class="docs-prose"><slot /></div>
    </article>
  </div>
</BaseLayout>
