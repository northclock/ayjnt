{
  "name": "ayjnt",
  "version": "0.1.0",
  "description": "Agent-first framework for Cloudflare. No worker boilerplate, no wrangler wrestling.",
  "type": "module",
  "module": "src/runtime/index.ts",
  "bin": {
    "ayjnt": "./bin/ayjnt.ts"
  },
  "exports": {
    ".": "./src/runtime/index.ts",
    "./rpc": "./src/runtime/rpc.ts",
    "./middleware": "./src/runtime/middleware.ts"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "ayjnt": "bun run bin/ayjnt.ts",
    "test": "bun test"
  },
  "keywords": [
    "cloudflare",
    "agents",
    "durable-objects",
    "framework",
    "mcp"
  ],
  "peerDependencies": {
    "agents": "*",
    "wrangler": "^3 || ^4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
