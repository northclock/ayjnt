{
  "name": "ayjnt",
  "version": "0.5.3",
  "description": "Agent-first framework for Cloudflare. No worker boilerplate, no wrangler wrestling.",
  "type": "module",
  "bin": {
    "ayjnt": "./dist/ayjnt.js"
  },
  "exports": {
    ".": {
      "bun": "./src/runtime/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "bun": "./src/runtime/rpc.ts",
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./middleware": {
      "bun": "./src/runtime/middleware.ts",
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    }
  },
  "files": [
    "src",
    "dist",
    ".claude/skills",
    "README.md"
  ],
  "scripts": {
    "ayjnt": "bun run bin/ayjnt.ts",
    "test": "bun test",
    "build": "bunup && bun scripts/postbuild.ts",
    "prepublishOnly": "bun run test && bun run build",
    "publish:dry": "bun publish --dry-run",
    "release": "bun publish"
  },
  "keywords": [
    "cloudflare",
    "agents",
    "durable-objects",
    "framework",
    "mcp"
  ],
  "dependencies": {
    "agents": "0.10.2",
    "wrangler": "4.82.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260413.1",
    "@types/bun": "latest",
    "bunup": "^0.16.31"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
