{
  "name": "ayjnt",
  "version": "0.5.9",
  "description": "A human-first agent harness framework powered by Bun and workerd.",
  "type": "module",
  "bin": {
    "ayjnt": "./dist/ayjnt.js"
  },
  "exports": {
    ".": {
      "bun": "./src/runtime/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "bun": "./src/runtime/rpc.ts",
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./middleware": {
      "bun": "./src/runtime/middleware.ts",
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./router": {
      "bun": "./src/runtime/router.ts",
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./browser": {
      "bun": "./src/runtime/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./voice/client": {
      "bun": "./src/runtime/voiceClient.tsx",
      "types": "./dist/voiceClient.d.ts",
      "import": "./dist/voiceClient.js",
      "default": "./dist/voiceClient.js"
    },
    "./workflow": {
      "bun": "./src/runtime/workflow.ts",
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js",
      "default": "./dist/workflow.js"
    },
    "./workflows": {
      "bun": "./src/runtime/workflows.ts",
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js",
      "default": "./dist/workflows.js"
    },
    "./client": {
      "bun": "./src/runtime/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./session": {
      "bun": "./src/runtime/session.ts",
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "default": "./dist/session.js"
    },
    "./cli": {
      "bun": "./src/runtime/cliContext.ts",
      "types": "./dist/cliContext.d.ts",
      "import": "./dist/cliContext.js",
      "default": "./dist/cliContext.js"
    },
    "./tools": {
      "bun": "./src/runtime/tools.ts",
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js",
      "default": "./dist/tools.js"
    },
    "./internal/run": {
      "bun": "./src/cli/run.ts",
      "types": "./dist/run.d.ts",
      "import": "./dist/run.js",
      "default": "./dist/run.js"
    },
    "./internal/host": {
      "bun": "./src/cli/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    }
  },
  "files": [
    "src",
    "dist",
    ".agents/skills",
    ".claude/skills",
    "README.md"
  ],
  "scripts": {
    "ayjnt": "bun run bin/ayjnt.ts",
    "test": "bun test",
    "dev:temp": "bun run scripts/dev-temp.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "bunup && bun scripts/postbuild.ts",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build",
    "publish:dry": "bun publish --dry-run",
    "release": "bun publish"
  },
  "keywords": [
    "agents",
    "agent-harness",
    "human-in-the-loop",
    "bun",
    "workerd",
    "framework",
    "mcp"
  ],
  "dependencies": {
    "wrangler": "4.82.1"
  },
  "peerDependencies": {
    "agents": "^0.13.1",
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "agents": {
      "optional": false
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/codemode": "^0.3.7",
    "@cloudflare/voice": "^0.2.0",
    "@cloudflare/workers-types": "4.20260413.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "agents": "^0.13.1",
    "bunup": "^0.16.31",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
