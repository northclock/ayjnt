{
  "name": "ayjnt",
  "version": "0.5.6",
  "description": "Agent-first framework for Cloudflare. No worker boilerplate, no wrangler wrestling.",
  "type": "module",
  "bin": {
    "ayjnt": "./dist/ayjnt.js"
  },
  "exports": {
    ".": {
      "bun": "./src/runtime/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "bun": "./src/runtime/rpc.ts",
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    },
    "./middleware": {
      "bun": "./src/runtime/middleware.ts",
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "default": "./dist/middleware.js"
    },
    "./router": {
      "bun": "./src/runtime/router.ts",
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "default": "./dist/router.js"
    },
    "./browser": {
      "bun": "./src/runtime/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./voice/client": {
      "bun": "./src/runtime/voiceClient.tsx",
      "types": "./dist/voiceClient.d.ts",
      "import": "./dist/voiceClient.js",
      "default": "./dist/voiceClient.js"
    },
    "./workflow": {
      "bun": "./src/runtime/workflow.ts",
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js",
      "default": "./dist/workflow.js"
    }
  },
  "files": [
    "src",
    "dist",
    ".claude/skills",
    "README.md"
  ],
  "scripts": {
    "ayjnt": "bun run bin/ayjnt.ts",
    "test": "bun test",
    "dev:temp": "bun run scripts/dev-temp.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "bunup && bun scripts/postbuild.ts",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build",
    "publish:dry": "bun publish --dry-run",
    "release": "bun publish"
  },
  "keywords": [
    "cloudflare",
    "agents",
    "durable-objects",
    "framework",
    "mcp"
  ],
  "dependencies": {
    "wrangler": "4.82.1"
  },
  "peerDependencies": {
    "agents": "^0.13.1"
  },
  "peerDependenciesMeta": {
    "agents": {
      "optional": false
    }
  },
  "devDependencies": {
    "@cloudflare/codemode": "^0.3.7",
    "@cloudflare/voice": "^0.2.0",
    "@cloudflare/workers-types": "4.20260413.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "agents": "^0.13.1",
    "bunup": "^0.16.31",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
